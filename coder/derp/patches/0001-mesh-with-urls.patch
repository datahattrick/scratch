+// meshTarget parses a -mesh-with entry. An entry is a hostname (dialed as
+// https://<host>/derp) or a full http(s) URL, optionally followed by
+// "|<dial address>" to connect to that address instead of the URL's host
+// while keeping the URL's host for TLS verification.
+func meshTarget(entry string) (urlStr, dialAddr string) {
+	target, dialAddr, _ := strings.Cut(strings.TrimSpace(entry), "|")
+	if strings.Contains(target, "://") {
+		return target, dialAddr
+	}
+	return "https://" + target + "/derp", dialAddr
+}
+
+func startMeshWithHost(s *derp.Server, entry string) error {
+	urlStr, dialAddr := meshTarget(entry)
+	logf := logger.WithPrefix(log.Printf, fmt.Sprintf("mesh(%q): ", urlStr))
+	c, err := derphttp.NewClient(s.PrivateKey(), urlStr, logf)
 	if err != nil {
 		return err
 	}
